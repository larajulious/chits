{
  "expo": {
    "name": "Chits",
    "slug": "Chits",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon.png",
    "scheme": "chits",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app_icon.png",
      "bundleIdentifier": "com.larajulious.chitsapp",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCFCFA",
        "foregroundImage": "./assets/images/app_icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.larajulious.chitsapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFCFA",
          "image": "./assets/images/app_splash_screen.png",
          "imageWidth": 360,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Chits to add selected photos and videos to your private chat.",
          "cameraPermission": false,
          "microphonePermission": "Allow Chits to record a voice note for your private chat."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Chits to record a voice note for your private chat.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-video",
      "expo-asset",
      "expo-sharing",
      "react-native-zip-archive",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "304ddcfb-f959-4355-a163-5d6315e68c13"
      }
    }
  }
}
