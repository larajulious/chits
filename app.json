{
  "expo": {
    "name": "Chits",
    "slug": "Chits",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon.png",
    "scheme": "chits",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app_icon.png",
      "bundleIdentifier": "com.larajulious.chitsapp",
      "version": "1.0.2",
      "buildNumber": "11",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Chits saves a copy of a photo, video or Share Note image to your photo library only when you choose to save it.",
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.larajulious.chits.backup",
            "UTTypeDescription": "Chits Backup",
            "UTTypeConformsTo": [
              "public.zip-archive"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "chitsbackup"
              ],
              "public.mime-type": [
                "application/x-chits-backup"
              ]
            }
          }
        ]
      },
      "appleTeamId": "9JQLWTZ683"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F6",
        "foregroundImage": "./assets/images/app_icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.larajulious.chitsapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F6",
          "image": "./assets/images/app_icon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chits only uses the photos and videos you choose to attach to a note or set as your chat background.",
          "cameraPermission": false,
          "microphonePermission": "Chits uses your microphone only when you choose to record a voice note."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Chits uses your microphone only when you choose to record a voice note.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-video",
      "expo-asset",
      "expo-sharing",
      "react-native-zip-archive",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#6E63D9"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "304ddcfb-f959-4355-a163-5d6315e68c13"
      }
    }
  }
}
