<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets "Open in another app" check for a capable app before showing
       the chooser (package visibility, Android 11+). No permission required. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:mimeType="*/*" />
    </intent>
  </queries>
</manifest>
