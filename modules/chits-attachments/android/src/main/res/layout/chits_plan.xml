<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/plan_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/chits_anywhere_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/plan_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textStyle="bold" android:text="@string/plan_widget_today" />
  <TextView android:id="@+id/plan_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="6dp" android:visibility="gone" />
 </LinearLayout>
 <ProgressBar android:id="@+id/plan_progress" style="@android:style/Widget.Material.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp" android:visibility="gone" />
 <LinearLayout android:id="@+id/plan_tasks" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="vertical" android:visibility="gone" />
 <TextView android:id="@+id/plan_message" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:maxLines="3" android:ellipsize="end" android:textSize="13sp" android:text="@string/plan_widget_none" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
  <TextView android:id="@+id/plan_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center" android:paddingHorizontal="12dp" android:maxLines="1" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/chits_anywhere_action" android:visibility="gone" />
  <TextView android:id="@+id/plan_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center" android:layout_marginStart="6dp" android:paddingHorizontal="12dp" android:maxLines="1" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/chits_anywhere_action" android:visibility="gone" />
 </LinearLayout>
</LinearLayout>
