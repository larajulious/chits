<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/anywhere_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/chits_anywhere_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
  <ImageView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/chits_anywhere_icon_frame" android:clipToOutline="true" android:src="@drawable/chits_anywhere_icon" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
  <TextView android:id="@+id/anywhere_brand" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="8dp" android:text="@string/anywhere_brand" android:textSize="12sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:textColor="#24231F"/>
  <TextView android:id="@+id/anywhere_quick" android:layout_width="104dp" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:drawableStart="@drawable/chits_anywhere_compose" android:drawablePadding="5dp" android:background="@drawable/chits_anywhere_action" android:text="@string/anywhere_quick" android:textStyle="bold" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:textColor="#2B2410"/>
 </LinearLayout>
 <TextView android:id="@+id/anywhere_recent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="0dp" android:text="@string/anywhere_recent" android:includeFontPadding="false" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:textColor="#5F5C52"/>
 <TextView android:id="@+id/anywhere_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/anywhere_hidden" android:maxLines="4" android:textSize="12sp" android:textColor="#5F5C52"/>
 <LinearLayout android:id="@+id/anywhere_notes" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:showDividers="middle" android:divider="@drawable/chits_anywhere_divider" />
</LinearLayout>
